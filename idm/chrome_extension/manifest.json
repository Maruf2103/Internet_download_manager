{
  "manifest_version": 3,
  "name": "Flow Download Manager",
  "version": "2.0.0",
  "description": "Send files, app installers, and folder links to your local Flow download manager.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "storage",
    "downloads",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Flow Download Manager",
    "default_popup": "popup.html",
    "default_icon": {
      "64": "icon.png"
    }
  },
  "icons": {
    "64": "icon.png"
  }
}